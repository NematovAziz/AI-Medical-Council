@model PatientDetailVm
@{
    ViewData["Title"] = Model.Patient.FullName;
    var p = Model.Patient;
    var last = Model.Encounters.FirstOrDefault();
    var lastCouncil = Model.CouncilSessions.FirstOrDefault();
    int Age(DateOnly b)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var a = today.Year - b.Year;
        if (b > today.AddYears(-a)) a--;
        return a;
    }
    string RiskTag(string level) => level switch { "Kritik" => "c", "Yuqori" => "w", "O'rta" => "w", _ => "ok" };
}

<div class="head anim">
    <div>
        <div class="eyebrow">@L["Bemor kartasi"] · #@p.Id</div>
        <h1>@p.FullName</h1>
        <p>@Age(p.BirthDate) @L["yosh"] · @p.Sex · @(p.Phone ?? "—")</p>
    </div>
    <div class="head-actions">
        <a class="btn" asp-controller="Labs" asp-action="Index" asp-route-patientId="@p.Id">@L["Analizlar"]</a>
        <a class="btn" asp-action="Timeline" asp-route-id="@p.Id">@L["Timeline"]</a>
        <a class="btn-key" asp-action="AddEncounter" asp-route-id="@p.Id">+ @L["Yangi tashrif"]</a>
    </div>
</div>

<div class="cols-3 anim d1">
    <section class="panel">
        <div class="ph compact"><div><h2>@L["Klinik profil"]</h2></div></div>
        <dl class="dl">
            <div><dt>@L["Tug'ilgan sana"]</dt><dd class="mono">@p.BirthDate.ToString("dd.MM.yyyy")</dd></div>
            <div><dt>@L["Allergiyalar"]</dt><dd>@(string.IsNullOrWhiteSpace(p.Allergies) ? "—" : p.Allergies)</dd></div>
            <div><dt>@L["SURUNKALI"]</dt><dd>@(string.IsNullOrWhiteSpace(p.ChronicConditions) ? "—" : p.ChronicConditions)</dd></div>
            <div><dt>@L["Ro'yxatga olingan"]</dt><dd class="mono">@p.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy")</dd></div>
        </dl>
    </section>

    <section class="panel">
        <div class="ph compact"><div><h2>@L["Oxirgi ko'rsatkichlar"]</h2><p>@(last is null ? "MA'LUMOT YO'Q" : last.OccurredAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</p></div></div>
        @if (last is null)
        {
            <div class="empty">@L["Tashriflar yo'q"]</div>
        }
        else
        {
            <div class="vit">
                <div class="@(last.SystolicBp >= 160 ? "warm" : "")"><span>BP</span><b>@(last.SystolicBp?.ToString() ?? "—")/@(last.DiastolicBp?.ToString() ?? "—")</b><small>mmHg</small></div>
                <div class="@(last.HeartRate > 120 ? "hot" : "")"><span>HR</span><b>@(last.HeartRate?.ToString() ?? "—")</b><small>bpm</small></div>
                <div class="@(last.SpO2 < 92 ? "hot" : "")"><span>SpO₂</span><b>@(last.SpO2?.ToString() ?? "—")</b><small>%</small></div>
                <div><span>Hb</span><b>@(last.Hemoglobin?.ToString() ?? "—")</b><small>g/L</small></div>
                <div><span>GLYUKOZA</span><b>@(last.Glucose?.ToString() ?? "—")</b><small>mmol/L</small></div>
                <div><span>#</span><b style="font-size:13px">#@last.Id</b><small></small></div>
            </div>
        }
    </section>

    <section class="panel">
        <div class="ph compact"><div><h2>@L["Oxirgi konsilium"]</h2></div></div>
        @if (lastCouncil is null)
        {
            <div class="empty">@L["Sessiyalar yo'q"]</div>
        }
        else
        {
            <div style="display:flex;align-items:center;gap:16px">
                <div style="width:110px;flex:0 0 110px">
                    <partial name="_RiskRing" model="@lastCouncil.RiskScore" />
                </div>
                <div style="min-width:0">
                    <span class="tag @RiskTag(lastCouncil.RiskLevel)">@L[lastCouncil.RiskLevel].ToUpper()</span>
                    <p class="dim" style="font-size:11px;line-height:1.6;margin:10px 0 0">@lastCouncil.MainHypothesis</p>
                    <a class="btn btn-sm" style="margin-top:10px" asp-controller="Council" asp-action="Result" asp-route-id="@lastCouncil.Id">@L["Hisobot"]</a>
                </div>
            </div>
        }
    </section>
</div>

<div class="cols reveal" style="margin-top:16px">
    <section class="panel">
        <div class="ph">
            <div><h2>@L["Klinik tashriflar"]</h2></div>
            <a asp-action="Timeline" asp-route-id="@p.Id">@L["Timeline"] →</a>
        </div>
        @if (!Model.Encounters.Any())
        {
            <div class="empty"><b>@L["Tashriflar yo'q"]</b></div>
        }
        else
        {
            <div class="tw">
                <table>
                    <thead><tr><th>@L["SANA"]</th><th>@L["SIMPTOMLAR"]</th><th>BP</th><th>HR</th><th>SpO₂</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var e in Model.Encounters)
                    {
                        <tr>
                            <td class="mono faint">@e.OccurredAtUtc.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td class="dim" style="max-width:280px">@e.Symptoms</td>
                            <td class="mono">@(e.SystolicBp?.ToString() ?? "—")/@(e.DiastolicBp?.ToString() ?? "—")</td>
                            <td class="mono">@(e.HeartRate?.ToString() ?? "—")</td>
                            <td class="mono">@(e.SpO2?.ToString() ?? "—")</td>
                            <td style="text-align:right">
                                <a class="btn btn-sm" asp-controller="Council" asp-action="Live"
                                   asp-route-patientId="@p.Id" asp-route-encounterId="@e.Id">@L["Konsilium"]</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <div class="stack">
        <section class="panel">
            <div class="ph compact"><div><h2>@L["Dorilar"]</h2></div></div>
            @if (!Model.Medications.Any())
            {
                <div class="empty">@L["Ma'lumot yo'q"]</div>
            }
            else
            {
                <dl class="dl">
                    @foreach (var m in Model.Medications)
                    {
                        <div>
                            <dt style="letter-spacing:0;font-size:11.5px;font-family:var(--sans);color:var(--txt)">@m.Name</dt>
                            <dd class="faint">@(m.Dose ?? "—") @(m.IsActive ? "" : "· to'xtatilgan")</dd>
                        </div>
                    }
                </dl>
            }
        </section>

        <section class="panel">
            <div class="ph compact"><div><h2>@L["Konsilium tarixi"]</h2></div></div>
            @if (!Model.CouncilSessions.Any())
            {
                <div class="empty">@L["Sessiyalar yo'q"]</div>
            }
            else
            {
                <dl class="dl">
                    @foreach (var c in Model.CouncilSessions.Take(6))
                    {
                        <div>
                            <dt>@c.CreatedAtUtc.ToLocalTime().ToString("dd.MM HH:mm")</dt>
                            <dd>
                                <a asp-controller="Council" asp-action="Result" asp-route-id="@c.Id">
                                    <span class="tag @RiskTag(c.RiskLevel)">@L[c.RiskLevel].ToUpper() · @c.RiskScore</span>
                                </a>
                            </dd>
                        </div>
                    }
                </dl>
            }
        </section>
    </div>
</div>
